# QueryWise Environment Configuration

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Database Connection (Optional)
# If left commented or empty, QueryWise automatically boots an embedded PostgreSQL 16 engine (PGlite)
# For Amazon RDS PostgreSQL or Supabase, provide the full connection URI:
# DATABASE_URL=postgres://querywise_user:your_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/querywise_db

# Google Gemini API Key (Optional)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# If omitted or invalid, QueryWise uses its built-in deterministic rule-based engine without crashing.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (For CORS when running separately)
FRONTEND_URL=http://localhost:5173

